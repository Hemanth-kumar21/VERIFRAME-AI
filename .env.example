# Copy to .env and fill in your values locally.
# Never commit a real API key.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=
VISION_MODEL=

# Image request limits (defaults: 10 MiB and 10 megapixels).
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=10000000

# Video decoding requires FFmpeg and ffprobe installed on the backend PATH.
# Defaults are resource-conscious and configurable for the deployment.
VIDEO_MAX_SIZE_MB=100
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_MAX_RESOLUTION_WIDTH=1920
VIDEO_MAX_RESOLUTION_HEIGHT=1080
VIDEO_MAX_FPS=60
MAX_ANALYZED_FRAMES=24
FRAME_SAMPLE_INTERVAL_SECONDS=5
VIDEO_SCENE_SAMPLE_INTERVAL_SECONDS=2
VIDEO_SCENE_THRESHOLD=0.30
MAX_FACE_TRACKS=0
VIDEO_ANALYSIS_TIMEOUT_SECONDS=300

# Configure two different Hugging Face image-classification models after
# verifying each model card and the exact AI-class label it returns.
DETECTOR_A_MODEL=
DETECTOR_A_AI_LABEL=
DETECTOR_B_MODEL=
DETECTOR_B_AI_LABEL=
# Optional third model, also verified by you before configuration.
DETECTOR_C_MODEL=
DETECTOR_C_AI_LABEL=

# Optional token protecting aggregate insights.
INSIGHTS_ACCESS_TOKEN=

# The hackathon submission must use the Nebius Token Factory endpoint and a
# Nemotron model ID that you verify from Nebius /v1/models.
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
# LLM_MODEL=
