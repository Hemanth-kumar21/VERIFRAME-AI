# Copy to .env and fill in your values locally.
# Never commit real API keys to version control.

# NVIDIA Nemotron Multimodal Video Reasoning API
NVIDIA_API_KEY=PASTE_YOUR_NEW_NVIDIA_API_KEY_HERE
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_MAX_TOKENS=2048
NVIDIA_REASONING_BUDGET=1024

# Personal Agent Provider Configuration (Groq / OpenAI compatible)
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1
AGENT_MODEL=qwen/qwen3.8-27b

# Forensic Detector Pipeline
DEMO_DETECTORS=true
DETECTOR_A_MODEL=demo-edge
DETECTOR_A_AI_LABEL=ai
DETECTOR_B_MODEL=demo-entropy
DETECTOR_B_AI_LABEL=ai

# Production Deployment Configuration (VPS / Docker)
# If using a custom domain with Caddy (automatic SSL): SERVER_NAME=veriframe.yourdomain.com
# If using raw server IP without a domain: SERVER_NAME=:80
SERVER_NAME=:80
# Leave empty when using Caddy reverse proxy on same domain, or set to http://<YOUR_IP>:8000 for direct port exposure
NEXT_PUBLIC_API_URL=
